# ===== Aplicação =====
NODE_ENV=development
LOG_LEVEL=debug

# ===== API =====
API_PORT=3333
API_BASE_URL=http://localhost:3333

# ===== Web =====
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3333

# ===== Banco de dados =====
DATABASE_URL=postgresql://deliveryhub:deliveryhub@localhost:55432/deliveryhub?schema=public
DATABASE_URL_SHADOW=postgresql://deliveryhub:deliveryhub@localhost:55432/deliveryhub_shadow?schema=public

# ===== Redis (filas + cache + Socket.IO pub/sub) =====
REDIS_URL=redis://localhost:56379

# ===== Auth =====
JWT_ACCESS_SECRET=change-me-in-prod-32-bytes-min
JWT_REFRESH_SECRET=change-me-in-prod-32-bytes-min
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ===== Vault (cifragem de tokens de plataforma) =====
# Gere com: openssl rand -base64 32
VAULT_MASTER_KEY=change-me-base64-32-bytes

# ===== iFood =====
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_API_BASE_URL=https://merchant-api.ifood.com.br
IFOOD_WEBHOOK_SECRET=
IFOOD_OAUTH_REDIRECT_URI=http://localhost:3000/integrations/ifood/callback

# ===== Rappi Partners (requer parceria comercial) =====
RAPPI_CLIENT_ID=
RAPPI_CLIENT_SECRET=
RAPPI_API_BASE_URL=https://services.rappi.com
RAPPI_WEBHOOK_SECRET=

# ===== Uber Eats Marketplace (requer parceria comercial) =====
UBEREATS_CLIENT_ID=
UBEREATS_CLIENT_SECRET=
UBEREATS_API_BASE_URL=https://api.uber.com
UBEREATS_WEBHOOK_SECRET=
UBEREATS_REDIRECT_URI=http://localhost:3000/integrations/ubereats/callback

# ===== AiQfome / Magalu Marketplace (API Key, sob NDA) =====
AIQFOME_API_KEY=
AIQFOME_API_BASE_URL=https://api.aiqfome.com
AIQFOME_WEBHOOK_SECRET=

# ===== 99Food / DiDi Food Open Platform (developer-food.99app.com) =====
DIDIFOOD_CLIENT_ID=
DIDIFOOD_CLIENT_SECRET=
DIDIFOOD_API_BASE_URL=https://openapi.99food.com
DIDIFOOD_WEBHOOK_SECRET=

# ===== Keeta / Meituan Overseas (developers.mykeeta.com) =====
KEETA_CLIENT_ID=
KEETA_CLIENT_SECRET=
KEETA_API_BASE_URL=https://openapi.mykeeta.com
KEETA_WEBHOOK_SECRET=

# ===== E-mail (Resend; vazio = ConsoleEmailSender em dev) =====
RESEND_API_KEY=
EMAIL_FROM=DeliveryHub <no-reply@deliveryhub.com.br>
WEB_BASE_URL=http://localhost:3000

# ===== Object Storage (R2/S3 — usado em uploads de imagem) =====
# Como configurar Cloudflare R2 (recomendado):
#   1. dash.cloudflare.com → R2 → Create bucket (ex.: deliveryhub-uploads)
#   2. Settings → Public access → habilita "pub-<id>.r2.dev" OU custom domain
#   3. R2 → Manage R2 API Tokens → Create token (Object Read & Write no bucket)
#   4. Preencha abaixo. Sem essas vars o endpoint /uploads/image volta 503.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=deliveryhub-uploads
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=

# ===== Observabilidade =====
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# ===== Worker (mesma imagem da api; MODE=worker ativa consumers) =====
MODE=api
