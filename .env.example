# ===== Aplicação =====
NODE_ENV=development
LOG_LEVEL=debug

# ===== API =====
API_PORT=3333
API_BASE_URL=http://localhost:3333

# ===== Web =====
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3333

# ===== Banco de dados =====
DATABASE_URL=postgresql://deliveryhub:deliveryhub@localhost:55432/deliveryhub?schema=public
DATABASE_URL_SHADOW=postgresql://deliveryhub:deliveryhub@localhost:55432/deliveryhub_shadow?schema=public

# ===== Redis (filas + cache + Socket.IO pub/sub) =====
REDIS_URL=redis://localhost:56379

# ===== Auth =====
JWT_ACCESS_SECRET=change-me-in-prod-32-bytes-min
JWT_REFRESH_SECRET=change-me-in-prod-32-bytes-min
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ===== Vault (cifragem de tokens de plataforma) =====
# Gere com: openssl rand -base64 32
VAULT_MASTER_KEY=change-me-base64-32-bytes

# ===== iFood =====
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_API_BASE_URL=https://merchant-api.ifood.com.br
IFOOD_WEBHOOK_SECRET=
IFOOD_OAUTH_REDIRECT_URI=http://localhost:3000/integrations/ifood/callback

# ===== E-mail (Resend) =====
RESEND_API_KEY=
EMAIL_FROM=DeliveryHub <no-reply@deliveryhub.com.br>

# ===== Object Storage (R2/S3) =====
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=deliveryhub-uploads
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=

# ===== Observabilidade =====
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# ===== Worker (mesma imagem da api; MODE=worker ativa consumers) =====
MODE=api
