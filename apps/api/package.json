{
  "name": "@deliveryhub/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:worker": "MODE=worker node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1047.0",
    "@deliveryhub/aiqfome": "workspace:*",
    "@deliveryhub/db": "workspace:*",
    "@deliveryhub/didifood": "workspace:*",
    "@deliveryhub/ifood": "workspace:*",
    "@deliveryhub/keeta": "workspace:*",
    "@deliveryhub/rappi": "workspace:*",
    "@deliveryhub/shared": "workspace:*",
    "@deliveryhub/ubereats": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
