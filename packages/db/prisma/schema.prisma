// DeliveryHub — schema da Sprint 1: tenancy core + auth.
// Próximas sprints expandem com menu, orders, pauses, financial, audit_log.

generator client {
  provider     = "prisma-client-js"
  output       = "../generated/client"
  moduleFormat = "esm"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("DATABASE_URL_SHADOW")
}

// ============================================================
// Reference data
// ============================================================

model Platform {
  id       String  @id @default(uuid(7))
  code     String  @unique
  name     String
  colorHex String  @map("color_hex")
  active   Boolean @default(true)

  connections PlatformConnection[]
  feeProfiles PlatformFeeProfile[]

  @@map("platform")
}

enum ConnectionStatus {
  pending
  active
  error
  revoked

  @@map("connection_status")
}

model PlatformConnection {
  id                 String           @id @default(uuid(7))
  organizationId     String           @map("organization_id")
  storeId            String           @map("store_id")
  platformId         String           @map("platform_id")
  status             ConnectionStatus @default(pending)
  vaultRef           String?          @map("vault_ref")
  externalMerchantId String?          @map("external_merchant_id")
  lastSyncAt         DateTime?        @map("last_sync_at")
  lastErrorAt        DateTime?        @map("last_error_at")
  lastErrorMessage   String?          @map("last_error_message")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  platform     Platform     @relation(fields: [platformId], references: [id])

  @@unique([storeId, platformId])
  @@index([organizationId])
  @@map("platform_connection")
}

model PlatformFeeProfile {
  id                   String   @id @default(uuid(7))
  organizationId       String   @map("organization_id")
  storeId              String   @map("store_id")
  platformId           String   @map("platform_id")
  commissionPct        Decimal  @map("commission_pct") @db.Decimal(5, 2)
  paymentProcessingPct Decimal  @map("payment_processing_pct") @db.Decimal(5, 2)
  flatFeeCents         BigInt   @default(0) @map("flat_fee_cents")
  effectiveFrom        DateTime @default(now()) @map("effective_from") @db.Date
  createdAt            DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  platform     Platform     @relation(fields: [platformId], references: [id])

  @@unique([storeId, platformId, effectiveFrom])
  @@index([organizationId])
  @@map("platform_fee_profile")
}

model VaultSecret {
  id         String   @id @default(uuid(7))
  name       String   @unique
  ciphertext String
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("vault_secret")
}

// ============================================================
// Tenancy core
// ============================================================

enum TaxRegime {
  simples_nacional
  lucro_presumido
  lucro_real

  @@map("tax_regime")
}

model Organization {
  id         String    @id @default(uuid(7))
  name       String
  document   String?
  taxRegime  TaxRegime @default(simples_nacional) @map("tax_regime")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  memberships         Membership[]
  stores              Store[]
  invitations         Invitation[]
  platformConnections PlatformConnection[]
  platformFeeProfiles PlatformFeeProfile[]

  @@map("organization")
}

model User {
  id              String    @id @default(uuid(7))
  email           String    @unique
  passwordHash    String    @map("password_hash")
  name            String
  phone           String?
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  memberships         Membership[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  invitationsSent     Invitation[]         @relation("invitations_sent")
  invitationsAccepted Invitation[]         @relation("invitations_accepted")

  @@map("user")
}

enum Role {
  owner
  manager
  staff
  financial

  @@map("role")
}

model Membership {
  id             String   @id @default(uuid(7))
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           Role
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("membership")
}

model Store {
  id             String   @id @default(uuid(7))
  organizationId String   @map("organization_id")
  name           String
  address        Json?
  timezone       String   @default("America/Sao_Paulo")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platformConnections PlatformConnection[]
  platformFeeProfiles PlatformFeeProfile[]

  @@index([organizationId])
  @@map("store")
}

// ============================================================
// Auth
// ============================================================

model RefreshToken {
  id        String    @id @default(uuid(7))
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ip        String?
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_token")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7))
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ip        String?
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_token")
}

model Invitation {
  id               String    @id @default(uuid(7))
  organizationId   String    @map("organization_id")
  email            String
  role             Role
  tokenHash        String    @unique @map("token_hash")
  expiresAt        DateTime  @map("expires_at")
  acceptedAt       DateTime? @map("accepted_at")
  acceptedByUserId String?   @map("accepted_by_user_id")
  invitedByUserId  String    @map("invited_by_user_id")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("invitations_sent", fields: [invitedByUserId], references: [id])
  acceptedBy   User?        @relation("invitations_accepted", fields: [acceptedByUserId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([email])
  @@map("invitation")
}

// ============================================================
// Compliance & audit
// ============================================================

enum AuditAction {
  create
  update
  delete
  login
  logout
  signup
  refresh
  pause
  resume
  price_change
  export
  consent

  @@map("audit_action")
}

model AuditLog {
  id             String      @id @default(uuid(7))
  organizationId String?     @map("organization_id")
  userId         String?     @map("user_id")
  entity         String
  entityId       String?     @map("entity_id")
  action         AuditAction
  diff           Json?
  ip             String?
  userAgent      String?     @map("user_agent")
  at             DateTime    @default(now())

  @@index([organizationId, entity, at(sort: Desc)])
  @@index([userId, at(sort: Desc)])
  @@map("audit_log")
}
