// Compliance & audit
// ============================================================

enum AuditAction {
  create
  update
  delete
  login
  logout
  signup
  refresh
  pause
  resume
  price_change
  export
  consent

  @@map("audit_action")
}

model AuditLog {
  id             String      @id @default(uuid(7))
  organizationId String?     @map("organization_id")
  userId         String?     @map("user_id")
  entity         String
  entityId       String?     @map("entity_id")
  action         AuditAction
  diff           Json?
  ip             String?
  userAgent      String?     @map("user_agent")
  at             DateTime    @default(now())

  @@index([organizationId, entity, at(sort: Desc)])
  @@index([userId, at(sort: Desc)])
  @@map("audit_log")
}

// ============================================================
// Inventory: insumos, sub-receitas, estoque, fornecedores
// ============================================================
//
// Modelo geral:
//   Supplier         -> fornecedor (fornece para Ingredient via IngredientPurchase)
//   Ingredient       -> insumo (raw) OU sub-receita (sub_recipe).
//                       custo unitario em Decimal(18,8) — precisao critica
//                       (1g de carne = R$ 0,045 nao cabe em cents)
//   IngredientPurchase -> compra que aumenta estoque + atualiza custo medio
//   StockMovement    -> entrada/saida/ajuste; UNIQUE(refType, refId, ingredientId)
//                       garante idempotencia das baixas por pedido
//   RecipeComponent  -> linha de receita; polimorfica:
//                       (menuItemId presente, parentIngredientId nulo) = receita de produto final
//                       (menuItemId nulo, parentIngredientId presente)  = receita de sub-receita
//                       CHECK enforca exatamente um pai (migration).
//
// Cascata de custo:
//   Quando custo de um Ingredient muda, RecipeCostService recalcula
//   recursivamente todos os MenuItem (costMode=recipe) e Ingredient
//   (kind=sub_recipe) que dependem dele. Tudo em uma unica transacao.

enum IngredientUnit {
  gram
  kilogram
  milliliter
  liter
  unit

  @@map("ingredient_unit")
}

enum IngredientKind {
  raw
  sub_recipe

  @@map("ingredient_kind")
}

enum StockMovementReason {
  purchase
  sale
  adjustment
  waste
  transfer_in
  transfer_out
  initial
  recipe_consumption

  @@map("stock_movement_reason")
}

enum CostMode {
  manual
  recipe

  @@map("cost_mode")
}

model Supplier {
  id             String    @id @default(uuid(7))
  organizationId String    @map("organization_id")
  name           String
  document       String?
  email          String?
  phone          String?
  address        Json?
  notes          String?
  archivedAt     DateTime? @map("archived_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ingredientPurchases IngredientPurchase[]

  @@index([organizationId])
  @@map("supplier")
}

model Ingredient {
  id             String         @id @default(uuid(7))
  organizationId String         @map("organization_id")
  storeId        String         @map("store_id")
  kind           IngredientKind @default(raw)
  name           String
  unit           IngredientUnit
  /// Custo por unidade-base (gram/ml/unit). Decimal(18,8) preserva
  /// precisao em insumos comprados em quantidade (R$0,045/g).
  costPerUnit    Decimal        @default(0) @db.Decimal(18, 8) @map("cost_per_unit")
  /// Para kind=sub_recipe: quantas unidades a receita produz por execucao.
  /// Custo unitario da sub-receita = custo total dos componentes / batchYield.
  batchYield     Decimal?       @db.Decimal(18, 8) @map("batch_yield")
  /// Estoque minimo desejado. Quando saldo cai abaixo, gera alerta + notificacao.
  /// Em unidade-base do ingrediente. Null = sem alerta configurado.
  minLevel       Decimal?       @db.Decimal(18, 8) @map("min_level")
  /// Dias desejados de cobertura ao gerar sugestao de compra. Default 7
  /// (= comprar pra durar 1 semana). Null = sem sugestao automatica.
  targetDays     Int?           @map("target_days")
  notes          String?
  archivedAt     DateTime?      @map("archived_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store          Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  purchases      IngredientPurchase[]
  stockMovements StockMovement[]
  /// Receita propria desta sub-receita (linhas RecipeComponent com parentIngredientId = este id).
  /// Para kind=raw fica vazio.
  recipeOf       RecipeComponent[]    @relation("recipe_of_subrecipe")
  /// Onde este ingrediente aparece como componente (em MenuItem ou em outra sub-receita).
  usedIn         RecipeComponent[]    @relation("used_as_component")

  @@index([organizationId, storeId])
  @@index([organizationId, kind])
  @@map("ingredient")
}

model IngredientPurchase {
  id             String   @id @default(uuid(7))
  organizationId String   @map("organization_id")
  storeId        String   @map("store_id")
  ingredientId   String   @map("ingredient_id")
  supplierId     String?  @map("supplier_id")
  /// Quantidade comprada na unidade-base do Ingredient.
  quantity       Decimal  @db.Decimal(18, 8)
  /// Custo unitario nesta compra (pode diferir do costPerUnit "atual" do insumo).
  unitCost       Decimal  @db.Decimal(18, 8) @map("unit_cost")
  /// Custo total da nota (quantity * unitCost; armazenado pre-calculado pra relatorios).
  totalCost      Decimal  @db.Decimal(18, 8) @map("total_cost")
  invoiceNumber  String?  @map("invoice_number")
  purchasedAt    DateTime @default(now()) @map("purchased_at")
  notes          String?
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  supplier     Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("purchases_created", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, storeId, purchasedAt(sort: Desc)])
  @@index([ingredientId, purchasedAt(sort: Desc)])
  @@map("ingredient_purchase")
}

model StockMovement {
  id             String              @id @default(uuid(7))
  organizationId String              @map("organization_id")
  storeId        String              @map("store_id")
  ingredientId   String              @map("ingredient_id")
  /// Positivo = entrada, negativo = saida. Saldo do estoque = SUM(quantity).
  quantity       Decimal             @db.Decimal(18, 8)
  reason         StockMovementReason
  /// Referencia opcional: 'order'|'purchase'|'adjustment'|'recipe_consumption'.
  /// Combinado com refId, identifica a operacao que originou o movimento.
  refType        String?             @map("ref_type")
  refId          String?             @map("ref_id")
  notes          String?
  createdById    String?             @map("created_by_id")
  createdAt      DateTime            @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("stock_movements_created", fields: [createdById], references: [id], onDelete: SetNull)

  /// Idempotencia: a baixa de um mesmo pedido (refType='order', refId=orderId)
  /// nunca se aplica duas vezes — consumeForOrder faz pre-check disso.
  @@unique([refType, refId, ingredientId], map: "stock_movement_ref_unique")
  @@index([organizationId, storeId, ingredientId, createdAt(sort: Desc)])
  @@index([ingredientId, createdAt(sort: Desc)])
  @@map("stock_movement")
}

model RecipeComponent {
  id                 String          @id @default(uuid(7))
  organizationId     String          @map("organization_id")
  /// "Pai" da linha de receita: exatamente UM destes dois preenchido (CHECK enforca).
  menuItemId         String?         @map("menu_item_id")
  parentIngredientId String?         @map("parent_ingredient_id")
  /// Componente: insumo (kind=raw) ou sub-receita (kind=sub_recipe) consumido.
  ingredientId       String          @map("ingredient_id")
  /// Quantidade necessaria, na unidade-base do `ingredient`. Sempre normalizado.
  quantity           Decimal         @db.Decimal(18, 8)
  /// Unidade em que o usuario digitou (display only). Se preenchido, deve
  /// ser da mesma familia do ingredient.unit (g↔kg, ml↔L). Quando null,
  /// usamos o ingredient.unit. NAO afeta calculos — apenas preserva a
  /// preferencia visual na hora do edit.
  displayUnit        IngredientUnit? @map("display_unit")
  sortOrder          Int             @default(0) @map("sort_order")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  menuItem         MenuItem?    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  parentIngredient Ingredient?  @relation("recipe_of_subrecipe", fields: [parentIngredientId], references: [id], onDelete: Cascade)
  ingredient       Ingredient   @relation("used_as_component", fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([menuItemId])
  @@index([parentIngredientId])
  @@index([ingredientId])
  @@map("recipe_component")
}

// ============================================================
// Catálogo: enums e modelos extras (combo, sales kind, modifier groups)
// ============================================================

enum ProductKind {
  /// MenuItem comum, vendido individualmente. Receita aponta para insumos.
  single
  /// MenuItem composto de outros MenuItems (X-Bacon + Coca + Batata).
  /// Não tem receita própria — o CMV é a soma dos CMVs dos componentes.
  combo

  @@map("product_kind")
}

enum SalesKind {
  /// Produto principal (lanche, prato, pizza). Aparece como destaque.
  main
  /// Acompanhamento (batata, arroz). Pode ser vendido sozinho ou em combo.
  side
  /// Bebida. Ótimo candidato a cross-sell.
  drink
  /// Sobremesa. Ótimo candidato a cross-sell.
  dessert
  /// Adicional / extra. Tipicamente vendido como complemento, raramente sozinho.
  addon

  @@map("sales_kind")
}

enum ModifierGroupKind {
  /// "Escolha o molho", "Adicionais (cheddar extra, bacon)"
  ingredients
  /// "Ponto da carne", "Sem cebola?"
  specifications
  /// "Quer uma bebida com desconto?", "Sobremesa por mais R$X?"
  cross_sell
  /// "Precisa de talher plástico?", "Precisa de sachê?"
  disposables

  @@map("modifier_group_kind")
}

model ComboComponent {
  id                    String   @id @default(uuid(7))
  organizationId        String   @map("organization_id")
  /// O combo "dono" desta linha (productKind=combo).
  comboMenuItemId       String   @map("combo_menu_item_id")
  /// O item simples (productKind=single) que entra como componente.
  componentMenuItemId   String   @map("component_menu_item_id")
  /// Quantas vezes este componente entra no combo (geralmente 1).
  quantity              Int      @default(1)
  sortOrder             Int      @default(0) @map("sort_order")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  combo            MenuItem     @relation("combo_owner", fields: [comboMenuItemId], references: [id], onDelete: Cascade)
  componentItem    MenuItem     @relation("combo_component_item", fields: [componentMenuItemId], references: [id], onDelete: Restrict)

  /// Cada componente aparece no máximo uma vez em um combo (a "qtd" já
  /// expressa multiplicação).
  @@unique([comboMenuItemId, componentMenuItemId])
  @@index([componentMenuItemId])
  @@map("combo_component")
}

// ============================================================
// Despesas operacionais — alimentam o DRE real
// ============================================================
//
// Sem despesas, o sistema só mostra receita. Com despesas + CMV (derivado
// dos pedidos × custo do MenuItem), conseguimos calcular o lucro real
// mensal:
//
//   Faturamento bruto         = SUM(order.totalCents)
//   − Taxas das plataformas   = SUM(order.platformFeeCents + processingFeeCents + flatFeeCents)
//   = Faturamento líquido
//   − CMV                     = SUM(orderItem.qty × menuItem.costCents)
//   = Margem bruta
//   − Despesas operacionais   = SUM(expense.amountCents per period, expandindo recorrências)
//   = Resultado operacional (lucro/prejuízo)
//
// O DREService gera esse cálculo dado um período (mês).

enum ExpenseCategory {
  rent              /// Aluguel
  utilities         /// Água, luz, gás, internet
  payroll           /// Salários + encargos
  ingredients_misc  /// Insumos não cadastrados (compra avulsa, perecíveis)
  marketing         /// Anúncios, panfletagem, redes sociais
  taxes             /// Impostos (Simples, ICMS, IPTU…)
  equipment         /// Compra/manutenção de equipamento
  software          /// SaaS (DeliveryHub, PDV, etc.)
  fuel              /// Combustível pra moto/entrega
  packaging         /// Embalagem, sacolas, talheres descartáveis
  cleaning          /// Limpeza, descartáveis sanitários
  other             /// Catch-all

  @@map("expense_category")
}

enum ExpenseRecurrence {
  /// Pagamento único (uma compra de equipamento, um reparo, etc.)
  one_time
  /// Mesmo valor todo mês (aluguel, software). dueDay define o dia.
  monthly
  /// Mesmo valor toda semana.
  weekly
  /// Mesmo valor todo dia (raro — entregas de gelo, café).
  daily

  @@map("expense_recurrence")
}

model Expense {
  id             String            @id @default(uuid(7))
  organizationId String            @map("organization_id")
  storeId        String            @map("store_id")
  name           String
  category       ExpenseCategory
  /// Valor em centavos (BRL).
  amountCents    Int               @map("amount_cents")
  recurrence     ExpenseRecurrence @default(one_time)
  /// Dia do mês (1-28) ou dia da semana (0-6) dependendo da recurrence.
  /// Pra one_time é ignorado.
  dueDay         Int?              @map("due_day")
  /// Data em que a despesa ocorreu/foi paga (one_time) OU data de início
  /// da recorrência (monthly/weekly/daily — usado pra calcular periodos).
  occurredAt     DateTime          @default(now()) @map("occurred_at")
  /// Quando a recorrência foi descontinuada (ex.: rescindiu o aluguel).
  /// Despesas com endedAt < period.start não contam no DRE daquele mes.
  endedAt        DateTime?         @map("ended_at")
  /// Quem pagou (PIX, débito, dinheiro, transferencia).
  paymentMethod  String?           @map("payment_method")
  notes          String?
  createdById    String?           @map("created_by_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("expenses_created", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, storeId, occurredAt(sort: Desc)])
  @@index([organizationId, category])
  @@map("expense")
}
