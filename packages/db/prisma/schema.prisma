// DeliveryHub — schema da Sprint 1: tenancy core + auth.
// Próximas sprints expandem com menu, orders, pauses, financial, audit_log.

generator client {
  provider     = "prisma-client-js"
  output       = "../generated/client"
  moduleFormat = "esm"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("DATABASE_URL_SHADOW")
}

// ============================================================
// Reference data
// ============================================================

model Platform {
  id       String  @id @default(uuid(7))
  code     String  @unique
  name     String
  colorHex String  @map("color_hex")
  active   Boolean @default(true)

  connections     PlatformConnection[]
  feeProfiles     PlatformFeeProfile[]
  menuItemConfigs MenuItemPlatformConfig[]
  orders          Order[]
  webhookEvents   WebhookEvent[]
  payouts         Payout[]
  actionRequests  PlatformActionRequest[]

  @@map("platform")
}

enum ConnectionStatus {
  pending
  active
  error
  revoked

  @@map("connection_status")
}

model PlatformConnection {
  id                 String           @id @default(uuid(7))
  organizationId     String           @map("organization_id")
  storeId            String           @map("store_id")
  platformId         String           @map("platform_id")
  status             ConnectionStatus @default(pending)
  vaultRef           String?          @map("vault_ref")
  externalMerchantId String?          @map("external_merchant_id")
  lastSyncAt         DateTime?        @map("last_sync_at")
  lastErrorAt        DateTime?        @map("last_error_at")
  lastErrorMessage   String?          @map("last_error_message")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  platform     Platform     @relation(fields: [platformId], references: [id])

  @@unique([storeId, platformId])
  @@index([organizationId])
  @@map("platform_connection")
}

model PlatformFeeProfile {
  id                   String   @id @default(uuid(7))
  organizationId       String   @map("organization_id")
  storeId              String   @map("store_id")
  platformId           String   @map("platform_id")
  commissionPct        Decimal  @map("commission_pct") @db.Decimal(5, 2)
  paymentProcessingPct Decimal  @map("payment_processing_pct") @db.Decimal(5, 2)
  flatFeeCents         BigInt   @default(0) @map("flat_fee_cents")
  effectiveFrom        DateTime @default(now()) @map("effective_from") @db.Date
  createdAt            DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  platform     Platform     @relation(fields: [platformId], references: [id])

  @@unique([storeId, platformId, effectiveFrom])
  @@index([organizationId])
  @@map("platform_fee_profile")
}

// ============================================================
// Menu (Sprint 4 — cardápio centralizado, sem preço-por-plataforma ainda)
// ============================================================

model Category {
  id             String   @id @default(uuid(7))
  organizationId String   @map("organization_id")
  storeId        String   @map("store_id")
  name           String
  description    String?
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]
  pauses       Pause[]

  @@index([organizationId, storeId])
  @@map("category")
}

model MenuItem {
  id              String      @id @default(uuid(7))
  organizationId  String      @map("organization_id")
  storeId         String      @map("store_id")
  categoryId      String?     @map("category_id")
  name            String
  description     String?
  imageUrl        String?     @map("image_url")
  prepTimeMinutes Int?        @map("prep_time_minutes")
  costCents       Int         @default(0) @map("cost_cents")
  /// Como o `costCents` é definido: `manual` = usuário digita o CMV;
  /// `recipe` = calculado a partir de RecipeComponent (read-only via API).
  costMode        CostMode    @default(manual) @map("cost_mode")
  /// Tipo do produto: `single` = item simples; `combo` = composto de outros
  /// MenuItems via ComboComponent.
  productKind     ProductKind @default(single) @map("product_kind")
  /// Categoria de venda — diferente de Category (que é taxonomia visual no
  /// cardápio). salesKind define o PAPEL do item: principal, sobremesa,
  /// bebida, acompanhamento, ou adicional (cross-sell-ready).
  salesKind       SalesKind   @default(main) @map("sales_kind")
  allergens       String[]    @default([])
  sortOrder       Int         @default(0) @map("sort_order")
  archivedAt      DateTime?   @map("archived_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store             Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category          Category?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  modifierGroups    ModifierGroup[]
  platformConfigs   MenuItemPlatformConfig[]
  orderItems        OrderItem[]
  pauses            Pause[]
  recipeComponents  RecipeComponent[]
  /// Quando este item É um combo: as linhas de composição.
  comboComponents   ComboComponent[]         @relation("combo_owner")
  /// Quando este item entra em algum combo: as linhas onde ele aparece.
  usedInCombos      ComboComponent[]         @relation("combo_component_item")
  /// Quando este item é referenciado como complemento (Modifier.linkedMenuItem).
  usedAsModifier    Modifier[]               @relation("modifier_links_item")

  @@index([organizationId, storeId])
  @@index([categoryId])
  @@map("menu_item")
}

model ModifierGroup {
  id             String            @id @default(uuid(7))
  organizationId String            @map("organization_id")
  menuItemId     String            @map("menu_item_id")
  /// Categoria do grupo (iFood-style): `ingredients` (escolha do molho,
  /// adicionais que vão no item), `specifications` (perguntas: ponto da carne),
  /// `cross_sell` (sugestões: quer uma sobremesa?), `disposables` (talheres,
  /// sachês). Define o papel do grupo na UI do cliente final.
  kind           ModifierGroupKind @default(ingredients)
  name           String
  minSelect      Int               @default(0) @map("min_select")
  maxSelect      Int               @default(1) @map("max_select")
  required       Boolean           @default(false)
  sortOrder      Int               @default(0) @map("sort_order")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  menuItem     MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifiers    Modifier[]

  @@index([menuItemId])
  @@map("modifier_group")
}

model Modifier {
  id              String   @id @default(uuid(7))
  organizationId  String   @map("organization_id")
  modifierGroupId String   @map("modifier_group_id")
  name            String
  description     String?
  imageUrl        String?  @map("image_url")
  /// Delta de preço aplicado ao pedido quando este modifier é escolhido.
  /// Em centavos (BRL). Pode ser 0 ou negativo.
  costDeltaCents  Int      @default(0) @map("cost_delta_cents")
  sortOrder       Int      @default(0) @map("sort_order")
  /// Quando preenchido, este modifier referencia um MenuItem existente
  /// (estilo "Copiar complemento" do iFood). O preço/imagem podem
  /// sobrescrever os do MenuItem original; baixa de estoque expande pela
  /// receita do MenuItem linkado.
  linkedMenuItemId String? @map("linked_menu_item_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  modifierGroup      ModifierGroup       @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  linkedMenuItem     MenuItem?           @relation("modifier_links_item", fields: [linkedMenuItemId], references: [id], onDelete: SetNull)
  orderItemModifiers OrderItemModifier[]

  @@index([modifierGroupId])
  @@index([linkedMenuItemId])
  @@map("modifier")
}

// ============================================================
// Per-platform configuration of menu items (Sprint 5)
// ============================================================

model MenuItemPlatformConfig {
  id                 String    @id @default(uuid(7))
  organizationId     String    @map("organization_id")
  menuItemId         String    @map("menu_item_id")
  platformId         String    @map("platform_id")
  externalId         String?   @map("external_id")
  externalCategoryId String?   @map("external_category_id")
  sellingPriceCents  Int       @default(0) @map("selling_price_cents")
  isPublished        Boolean   @default(true) @map("is_published")
  isAvailable        Boolean   @default(true) @map("is_available")
  lastSyncAt         DateTime? @map("last_sync_at")
  lastSyncError      String?   @map("last_sync_error")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  menuItem     MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  platform     Platform     @relation(fields: [platformId], references: [id])

  @@unique([menuItemId, platformId])
  @@index([organizationId])
  @@map("menu_item_platform_config")
}

// ============================================================
// Notifications (Sprint 7)
// ============================================================

enum NotificationKind {
  welcome
  invitation_accepted
  integration_error
  password_changed
  new_order
  platform_disconnected
  payout_mismatch
  daily_goal
  stock_low
  order_action_request
  system

  @@map("notification_kind")
}

model Notification {
  id             String           @id @default(uuid(7))
  organizationId String?          @map("organization_id")
  userId         String           @map("user_id")
  kind           NotificationKind
  title          String
  body           String
  linkUrl        String?          @map("link_url")
  metadata       Json?
  readAt         DateTime?        @map("read_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notification")
}

model NotificationPreference {
  id            String           @id @default(uuid(7))
  userId        String           @map("user_id")
  kind          NotificationKind
  channelInApp  Boolean          @default(true) @map("channel_in_app")
  channelEmail  Boolean          @default(false) @map("channel_email")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@map("notification_preference")
}

// ============================================================
// Orders & Customers (Sprint 8 — Hub de Pedidos em tempo real)
// ============================================================

model Customer {
  id             String    @id @default(uuid(7))
  organizationId String    @map("organization_id")
  phoneHash      String?   @map("phone_hash") // sha256(dígitos) — dedup
  documentHash   String?   @map("document_hash") // sha256(dígitos) — dedup
  phone          String? // cifrado pela PII extension
  document       String? // cifrado pela PII extension
  name           String
  firstSeenAt    DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@unique([organizationId, phoneHash])
  @@unique([organizationId, documentHash])
  @@index([organizationId, lastSeenAt(sort: Desc)])
  @@map("customer")
}

enum OrderStatus {
  placed
  accepted
  preparing
  ready
  dispatched
  delivered
  cancelled

  @@map("order_status")
}

enum OrderStatusSource {
  platform
  user
  system

  @@map("order_status_source")
}

model Order {
  id                 String      @id @default(uuid(7))
  organizationId     String      @map("organization_id")
  storeId            String      @map("store_id")
  platformId         String      @map("platform_id")
  externalId         String      @map("external_id")
  customerId         String?     @map("customer_id")
  status             OrderStatus @default(placed)
  subtotalCents      Int         @map("subtotal_cents")
  deliveryFeeCents   Int         @default(0) @map("delivery_fee_cents")
  totalCents         Int         @map("total_cents")
  platformFeeCents   Int         @default(0) @map("platform_fee_cents")
  processingFeeCents Int         @default(0) @map("processing_fee_cents")
  flatFeeCents       Int         @default(0) @map("flat_fee_cents")
  netCents           Int         @map("net_cents")
  notes              String?
  placedAt           DateTime    @map("placed_at")
  acceptedAt         DateTime?   @map("accepted_at")
  dispatchedAt       DateTime?   @map("dispatched_at")
  deliveredAt        DateTime?   @map("delivered_at")
  cancelledAt        DateTime?   @map("cancelled_at")
  cancellationReason String?     @map("cancellation_reason")
  // Forma de pagamento informada pela plataforma: 'online' | 'cash' | 'other'.
  paymentMethod          String?   @map("payment_method")
  // Quem entrega: 'platform' (entregador da plataforma) | 'store' (loja).
  deliveryBy             String?   @map("delivery_by")
  // Marcado quando a loja confirma o recebimento do dinheiro (pedidos cash).
  cashPaymentConfirmedAt DateTime? @map("cash_payment_confirmed_at")
  // Entregador do pedido — vem do webhook deliveryStatus (entrega da
  // plataforma) ou é informado pela loja na entrega própria.
  courierName            String?   @map("courier_name")
  courierPhone           String?   @map("courier_phone")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store          Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  platform       Platform                @relation(fields: [platformId], references: [id])
  customer       Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  statusEvents   OrderStatusEvent[]
  actionRequests PlatformActionRequest[]

  @@unique([platformId, externalId])
  @@index([organizationId, storeId, placedAt(sort: Desc)])
  @@index([organizationId, status])
  @@map("order")
}

model OrderItem {
  id             String  @id @default(uuid(7))
  orderId        String  @map("order_id")
  menuItemId     String? @map("menu_item_id")
  externalId     String? @map("external_id")
  nameSnapshot   String  @map("name_snapshot")
  qty            Int
  unitPriceCents Int     @map("unit_price_cents")
  totalCents     Int     @map("total_cents")
  notes          String?

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem  MenuItem?           @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  modifiers OrderItemModifier[]

  @@index([orderId])
  @@map("order_item")
}

model OrderItemModifier {
  id             String  @id @default(uuid(7))
  orderItemId    String  @map("order_item_id")
  modifierId     String? @map("modifier_id")
  externalId     String? @map("external_id")
  nameSnapshot   String  @map("name_snapshot")
  qty            Int     @default(1)
  unitPriceCents Int     @map("unit_price_cents")

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifier  Modifier? @relation(fields: [modifierId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@map("order_item_modifier")
}

model OrderStatusEvent {
  id          String            @id @default(uuid(7))
  orderId     String            @map("order_id")
  status      OrderStatus
  source      OrderStatusSource
  actorUserId String?           @map("actor_user_id")
  at          DateTime          @default(now())
  metadata    Json?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, at(sort: Desc)])
  @@map("order_status_event")
}

model WebhookEvent {
  id          String    @id @default(uuid(7))
  platformId  String    @map("platform_id")
  externalId  String    @map("external_id")
  eventType   String    @map("event_type")
  payload     Json
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")
  error       String?

  platform Platform @relation(fields: [platformId], references: [id])

  @@unique([platformId, externalId])
  @@index([receivedAt(sort: Desc)])
  @@map("webhook_event")
}

// ============================================================
// Pedidos de ação do cliente (cancelamento / reembolso)
// 99Food: o cliente abre via atendimento; a loja aprova/recusa.
// ============================================================

enum PlatformActionRequestKind {
  cancellation
  refund

  @@map("platform_action_request_kind")
}

enum PlatformActionRequestStatus {
  pending
  approved
  declined

  @@map("platform_action_request_status")
}

model PlatformActionRequest {
  id               String                      @id @default(uuid(7))
  organizationId   String                      @map("organization_id")
  storeId          String                      @map("store_id")
  platformId       String                      @map("platform_id")
  orderId          String?                     @map("order_id")
  kind             PlatformActionRequestKind
  status           PlatformActionRequestStatus @default(pending)
  // IDs externos da plataforma — long 64-bit, guardados como string.
  externalOrderId  String                      @map("external_order_id")
  externalApplyId  String                      @map("external_apply_id")
  customerReason   String?                     @map("customer_reason")
  // Opções de motivo que a loja pode escolher ao responder (JSON da plataforma).
  reasonOptions    Json?                       @map("reason_options")
  // Imagens anexadas pelo cliente como evidência (reembolso).
  evidenceImages   Json?                       @map("evidence_images")
  resolvedByUserId String?                     @map("resolved_by_user_id")
  resolvedReason   String?                     @map("resolved_reason")
  resolvedAt       DateTime?                   @map("resolved_at")
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  platform     Platform     @relation(fields: [platformId], references: [id])
  order        Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([platformId, externalApplyId])
  @@index([organizationId, status])
  @@index([orderId])
  @@map("platform_action_request")
}

// ============================================================
// Pauses (Sprint 10 — diferencial #2: pausa multiplataforma)
// ============================================================

enum PauseScope {
  store
  category
  item

  @@map("pause_scope")
}

enum PauseReason {
  kitchen_overloaded
  end_of_shift
  out_of_stock
  scheduled
  other

  @@map("pause_reason")
}

model Pause {
  id                String      @id @default(uuid(7))
  organizationId    String      @map("organization_id")
  storeId           String      @map("store_id")
  scope             PauseScope
  categoryId        String?     @map("category_id")
  menuItemId        String?     @map("menu_item_id")
  platformIds       String[]    @map("platform_ids") // vazio = todas plataformas conectadas
  startsAt          DateTime    @default(now()) @map("starts_at")
  endsAt            DateTime?   @map("ends_at")
  reason            PauseReason @default(other)
  reasonNote        String?     @map("reason_note")
  createdByUserId   String      @map("created_by_user_id")
  cancelledAt       DateTime?   @map("cancelled_at")
  cancelledByUserId String?     @map("cancelled_by_user_id")
  appliedAt         DateTime?   @map("applied_at")     // confirmação de propagação
  reopenedAt        DateTime?   @map("reopened_at")    // quando o cron reabriu
  errorMessage      String?     @map("error_message")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  menuItem     MenuItem?    @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("pauses_created", fields: [createdByUserId], references: [id])
  cancelledBy  User?        @relation("pauses_cancelled", fields: [cancelledByUserId], references: [id])

  @@index([organizationId, storeId, startsAt(sort: Desc)])
  @@index([endsAt]) // varredura do cron de reabertura automática
  @@map("pause")
}

// ============================================================
// Financial — payouts and bank reconciliation (Sprint 11)
// ============================================================

enum PayoutStatus {
  pending // ainda esperando repasse
  partial // recebido < esperado
  reconciled // recebido == esperado (com tolerância)
  mismatch // recebido > esperado ou divergência inexplicada

  @@map("payout_status")
}

model Payout {
  id                   String       @id @default(uuid(7))
  organizationId       String       @map("organization_id")
  storeId              String       @map("store_id")
  platformId           String       @map("platform_id")
  referencePeriodStart DateTime     @map("reference_period_start") @db.Date
  referencePeriodEnd   DateTime     @map("reference_period_end") @db.Date
  expectedAmountCents  BigInt       @map("expected_amount_cents")
  expectedPayDate      DateTime?    @map("expected_pay_date") @db.Date
  receivedAmountCents  BigInt?      @map("received_amount_cents")
  receivedAt           DateTime?    @map("received_at")
  bankTransactionId    String?      @map("bank_transaction_id")
  status               PayoutStatus @default(pending)
  notes                String?
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store           Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  platform        Platform         @relation(fields: [platformId], references: [id])
  bankTransaction BankTransaction? @relation(fields: [bankTransactionId], references: [id], onDelete: SetNull)

  @@unique([platformId, storeId, referencePeriodStart, referencePeriodEnd])
  @@index([organizationId, status])
  @@index([organizationId, storeId, expectedPayDate])
  @@map("payout")
}

model BankTransaction {
  id             String   @id @default(uuid(7))
  organizationId String   @map("organization_id")
  storeId        String   @map("store_id")
  date           DateTime @db.Date
  amountCents    BigInt   @map("amount_cents")
  description    String
  raw            Json
  importedAt     DateTime @default(now()) @map("imported_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  payouts      Payout[]

  // Dedupe: mesma data + valor + descrição = mesma linha do extrato.
  @@unique([storeId, date, amountCents, description])
  @@index([organizationId, storeId, date(sort: Desc)])
  @@map("bank_transaction")
}

model VaultSecret {
  id         String   @id @default(uuid(7))
  name       String   @unique
  ciphertext String
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("vault_secret")
}

// ============================================================
// LGPD — consent log (Sprint 12)
// ============================================================

enum ConsentSubjectKind {
  user
  customer

  @@map("consent_subject_kind")
}

enum ConsentKind {
  terms
  privacy
  marketing

  @@map("consent_kind")
}

model ConsentLog {
  id          String             @id @default(uuid(7))
  subjectKind ConsentSubjectKind @map("subject_kind")
  subjectId   String             @map("subject_id")
  kind        ConsentKind
  version     String
  accepted    Boolean
  ip          String?
  userAgent   String?            @map("user_agent")
  at          DateTime           @default(now())

  @@index([subjectKind, subjectId, at(sort: Desc)])
  @@map("consent_log")
}

// ============================================================
// Tenancy core
// ============================================================

enum TaxRegime {
  simples_nacional
  lucro_presumido
  lucro_real

  @@map("tax_regime")
}

model Organization {
  id         String    @id @default(uuid(7))
  name       String
  document   String?
  taxRegime  TaxRegime @default(simples_nacional) @map("tax_regime")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  memberships             Membership[]
  stores                  Store[]
  invitations             Invitation[]
  platformConnections     PlatformConnection[]
  platformFeeProfiles     PlatformFeeProfile[]
  categories              Category[]
  menuItems               MenuItem[]
  modifierGroups          ModifierGroup[]
  modifiers               Modifier[]
  menuItemPlatformConfigs MenuItemPlatformConfig[]
  notifications           Notification[]
  customers               Customer[]
  orders                  Order[]
  pauses                  Pause[]
  payouts                 Payout[]
  bankTransactions        BankTransaction[]
  suppliers               Supplier[]
  ingredients             Ingredient[]
  ingredientPurchases     IngredientPurchase[]
  stockMovements          StockMovement[]
  recipeComponents        RecipeComponent[]
  comboComponents         ComboComponent[]
  expenses                Expense[]
  platformActionRequests  PlatformActionRequest[]

  @@map("organization")
}

model User {
  id              String    @id @default(uuid(7))
  email           String    @unique
  passwordHash    String    @map("password_hash")
  name            String
  phone           String?
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  memberships             Membership[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  invitationsSent         Invitation[]             @relation("invitations_sent")
  invitationsAccepted     Invitation[]             @relation("invitations_accepted")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  pausesCreated           Pause[]                  @relation("pauses_created")
  pausesCancelled         Pause[]                  @relation("pauses_cancelled")
  purchasesCreated        IngredientPurchase[]     @relation("purchases_created")
  stockMovementsCreated   StockMovement[]          @relation("stock_movements_created")
  expensesCreated         Expense[]                @relation("expenses_created")

  @@map("user")
}

enum Role {
  owner
  manager
  staff
  financial

  @@map("role")
}

model Membership {
  id             String   @id @default(uuid(7))
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           Role
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("membership")
}

model Store {
  id             String   @id @default(uuid(7))
  organizationId String   @map("organization_id")
  name           String
  address        Json?
  timezone       String   @default("America/Sao_Paulo")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platformConnections PlatformConnection[]
  platformFeeProfiles PlatformFeeProfile[]
  categories          Category[]
  menuItems           MenuItem[]
  orders              Order[]
  pauses              Pause[]
  payouts             Payout[]
  bankTransactions    BankTransaction[]
  ingredients         Ingredient[]
  ingredientPurchases IngredientPurchase[]
  stockMovements      StockMovement[]
  expenses            Expense[]
  actionRequests      PlatformActionRequest[]

  @@index([organizationId])
  @@map("store")
}

// ============================================================
// Auth
// ============================================================

model RefreshToken {
  id        String    @id @default(uuid(7))
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ip        String?
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_token")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7))
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ip        String?
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_token")
}

model Invitation {
  id               String    @id @default(uuid(7))
  organizationId   String    @map("organization_id")
  email            String
  role             Role
  tokenHash        String    @unique @map("token_hash")
  expiresAt        DateTime  @map("expires_at")
  acceptedAt       DateTime? @map("accepted_at")
  acceptedByUserId String?   @map("accepted_by_user_id")
  invitedByUserId  String    @map("invited_by_user_id")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("invitations_sent", fields: [invitedByUserId], references: [id])
  acceptedBy   User?        @relation("invitations_accepted", fields: [acceptedByUserId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([email])
  @@map("invitation")
}

