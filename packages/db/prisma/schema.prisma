// DeliveryHub — schema base de fundação.
// Sprint 1 expandirá este schema com organization/user/membership/store/refresh_token.
// Sprints subsequentes adicionam menu, orders, pauses, financial, audit_log.

generator client {
  provider     = "prisma-client-js"
  output       = "../generated/client"
  moduleFormat = "esm"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("DATABASE_URL_SHADOW")
}

// Placeholder mínimo para validar toolchain.
// Substituído na Sprint 1 (US-1.2).
model Platform {
  id       String  @id @default(uuid(7))
  code     String  @unique
  name     String
  colorHex String  @map("color_hex")
  active   Boolean @default(true)

  @@map("platform")
}
